    "pi-package",
    "extension",
    "tasks",
    "todo",
    "tilldone",
    "beads",
    "issue-tracker",
    "agent"
  ],
  "license": "MIT",
  "author": "bandepanu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bandepanu/tilldone-bd.git"
  },
  "main": "extensions/tilldone-bd.ts",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
